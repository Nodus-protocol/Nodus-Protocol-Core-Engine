TARGET_URL=https://staging.example.invalid
TOKEN_0=REPLACE_WITH_RELEASE_CANDIDATE_TOKEN_0
TOKEN_1=REPLACE_WITH_RELEASE_CANDIDATE_TOKEN_1
PAYMENT_TOKEN_0=XLM
PAYMENT_TOKEN_1=USDC
HOT_ACCOUNT=REPLACE_WITH_FUNDED_STAGING_ACCOUNT
# Comma-separated valid staging public keys (no secret signing material).
ACCOUNT_LIST=REPLACE_WITH_ACCOUNT_1,REPLACE_WITH_ACCOUNT_2
CONTRACT_ID=REPLACE_WITH_RELEASE_CANDIDATE_CONTRACT
RECONCILIATION_URL=https://staging.example.invalid/internal/reconciliation/status
EXPECTED_RATE=100
MAX_RATE=500
TEST_DURATION=10m

# Immutable release evidence
IMAGE=registry.example.invalid/nodus/core-engine@sha256:REPLACE_ME
SOURCE_REVISION=REPLACE_WITH_GIT_SHA
ABI_SHA256=REPLACE_WITH_ABI_SHA256
PROVIDERS=stellar-rpc=https://rpc.example.invalid
TEST_RESULT_SHA256=REPLACE_WITH_TEST_RESULT_SHA256

# Optional fault-control hooks (executed as commands)
RATE_LIMIT_HOOK=
DIVERGENT_RPC_HOOK=
ACCEPTED_TIMEOUT_HOOK=

# Fault proxy upstreams
REDIS_UPSTREAM=redis.example.invalid:6379
DATABASE_UPSTREAM=database.example.invalid:5432
RPC_UPSTREAM=rpc.example.invalid:443
