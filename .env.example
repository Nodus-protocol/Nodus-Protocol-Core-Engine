# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
RUST_LOG=nodus_core_engine=info,tower_http=info

# ── Stellar Network ───────────────────────────────────────────────────────────
# "mainnet" or "testnet"
NETWORK=testnet

# ── AMM Pool Contract ─────────────────────────────────────────────────────────
# Leave blank to run the engine without pool endpoints (payments still work).
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
POOL_CONTRACT_ID=
POOL_TOKEN_0=XLM
POOL_TOKEN_1=USDC

# ── Retry ─────────────────────────────────────────────────────────────────────
MAX_RETRY_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=200

# ── Redis (idempotency + auth nonce replay protection) ───────────────────────
# Optional. When set, idempotency keys and signed-request nonces survive
# engine restarts. When unset, both fall back to in-memory stores (lost on
# restart — fine for local dev, not for a multi-instance deployment).
# Idempotency keys use the "idem:" prefix, nonces use "nonce:".
REDIS_URL=redis://127.0.0.1:6379
IDEMPOTENCY_TTL_SECS=86400

# ── Release readiness ────────────────────────────────────────────────────────
EXPECTED_NETWORK=testnet
RELEASE_VERSION=dev
RELEASE_MANIFEST_SHA=replace-with-signed-manifest-sha
EXPECTED_MANIFEST_SHA=replace-with-signed-manifest-sha
CONTRACT_SPEC_VERSION=1
SUPPORTED_CONTRACT_SPEC_VERSION=1
RECONCILIATION_LAG_SECONDS=0
RECONCILIATION_LAG_MAX_SECONDS=30

# ── Engine service authentication ─────────────────────────────────────────────
# Every non-health endpoint requires a signed request from a known workload
# identity (see README "Service Authentication"). Format:
#   key_id:hex_secret(>=16 bytes):scope1|scope2;key_id2:hex_secret2:scope1
# Scopes: read, tx_construct, tx_submit, admin, diagnostics.
# Generate a secret with: openssl rand -hex 32
# Multiple keys may be active at once — that's what makes rotation
# zero-downtime: add the new key, roll callers over, then remove the old one.
ENGINE_AUTH_KEYS=

# Local-dev-only escape hatch. The engine refuses to start with this set to
# true when NETWORK=mainnet.
ENGINE_AUTH_DISABLED=false

# How much clock drift between caller and engine is tolerated, and how long
# a nonce is remembered for replay protection.
ENGINE_AUTH_CLOCK_SKEW_SECS=60
ENGINE_AUTH_REPLAY_WINDOW_SECS=300

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call this engine cross-origin.
# Leave blank for an internal-only deployment (no CORS headers are sent at
# all, so no browser origin can call the engine — this is the default and
# recommended setting for a backend-to-engine service).
CORS_ALLOWED_ORIGINS=

# ── Transport ──────────────────────────────────────────────────────────────────
# The engine itself speaks plain HTTP. Set this once TLS is terminated in
# front of it (load balancer, ingress, service-mesh mTLS sidecar, ...).
# Required when NETWORK=mainnet.
TLS_TERMINATED_UPSTREAM=false
# Explicit override to run without the attestation above — local dev only.
ENGINE_ALLOW_INSECURE_TRANSPORT=true
